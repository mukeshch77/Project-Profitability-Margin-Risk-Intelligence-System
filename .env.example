# ============================================
# BACKEND (FastAPI) Configuration
# ============================================

# PostgreSQL Database URL
# For local development: postgresql://postgres:postgres@localhost:5432/project_risk_db
# For Supabase: postgresql://postgres:[password]@[project-id].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_risk_db

# CORS Origins - Comma-separated list of allowed origins
# For development: http://localhost:3000
# For production: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3000

# Environment: development or production
ENVIRONMENT=development

# ML Model path (relative to app root or absolute)
# Docker: /app/outputs/margin_risk_model.joblib
# Local: outputs/margin_risk_model.joblib
MODEL_PATH=outputs/margin_risk_model.joblib

# ============================================
# FRONTEND (Next.js) Configuration
# ============================================

# API Base URL - Backend endpoint
# For development: http://localhost:8000
# For production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================
# DATABASE (Supabase) Configuration
# ============================================

# Supabase project URL (optional for initial setup)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase public API key (optional for initial setup)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
